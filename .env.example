# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
#
# Only `WXT_`-prefixed variables are exposed to the bundle, and only the ones
# declared in `src/types/env.d.ts` are typed.

# Your ExtensionPay extension id, from https://extensionpay.com.
# Register that id there first: until the extension exists, payments cannot
# complete. Copy this file to `.env` to override the default in the source.
WXT_EXTPAY_ID=notewisp

# --- Store submission (CI only; never commit real values) ---------------------
# Used by `pnpm submit` / the release workflow to upload a build.
# CHROME_EXTENSION_ID=
# CHROME_CLIENT_ID=
# CHROME_CLIENT_SECRET=
# CHROME_REFRESH_TOKEN=
# FIREFOX_EXTENSION_ID=
# FIREFOX_JWT_ISSUER=
# FIREFOX_JWT_SECRET=
